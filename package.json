{
  "name": "ziwei-master",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --",
    "build": "turbo run build",
    "start": "npm run start --workspace @ziwei/web",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "turbo run test && tsx scripts/regression/neutral-naming.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
